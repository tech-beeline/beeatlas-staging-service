@startuml DFD_2_P2_BDPN
!theme plain
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Arial
skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontColor #BF360C
}
skinparam ArrowFontColor #1565C0
skinparam ArrowColor #1565C0

title DFD-2: Декомпозиция P2 — Обработка заявки в БДПН

rectangle "**Сотрудники**" as Staff #E3F2FD
rectangle "**БДПН**\n(ЦБДПН)" as BDPN #FFEBEE
rectangle "**СМЭВ**\n(via UCRM)" as SMEV #FFEBEE
database "CRM-MNP БД" as D5 #FFF3E0
database "S3" as D6 #FFF3E0
database "Kafka" as D8 #FFF3E0

rectangle "**P2.1** Создание\nзаявки\n(NP Create /\nNP Region Change)" as P21 #C8E6C9
rectangle "**P2.2** Арбитраж\nи проверка ПДн" as P22 #C8E6C9
rectangle "**P2.3** Обработка\nдолга донора\n(Donor Info)" as P23 #C8E6C9
rectangle "**P2.4** Активация\nрегиона\n(Region Activate)" as P24 #C8E6C9
rectangle "**P2.5** Отмена\nзаявки\n(NP Cancel)" as P25 #C8E6C9
rectangle "**P2.6** Блокировка\nза задолж.\n(NP Suspend)" as P26 #C8E6C9
rectangle "**P2.7** Возврат\nномера\n(NP Return)" as P27 #C8E6C9
rectangle "**P2.8** Загрузка\nфайлов от БДПН\n(SFTP)" as P28 #C8E6C9

rectangle "→ P3\nПровижининг" as P3 #B3E5FC
rectangle "→ P5\nНотификация" as P5 #B3E5FC

' P2.1
Staff --> P21 : REST /portation-in/requests,\n/relocation/requests
P21 --> BDPN : NP Create, NP Region Change\n(newRoute, дата, ПДн)
BDPN --> P21 : NP CDB Confirm, NP CDB Reject
P21 --> D5 : Сохранение заявки
P21 --> D8 : Событие NP_CREATE

' P2.2
BDPN --> P22 : NP Verification Request,\nNP Data Request
P22 --> SMEV : POST /v1/document-check-smev
SMEV --> P22 : Результат проверки
P22 --> BDPN : NP Verification Exec,\nNP Data Response

' P2.3
BDPN --> P23 : NP Donor Info
P23 --> BDPN : NP Donor Accept,\nNP Donor Reject

' P2.4
BDPN --> P24 : Region Activate,\nNP Recipient Activate,\nNP Donor Activate
P24 --> BDPN : Region Activate Confirm,\nNP Deactivate Confirm
P24 --> P3 : Команда провижининга

' P2.5
Staff --> P25 : REST /requests/cancel
P25 --> BDPN : NP Cancel\n(+ файл заявления на SFTP)
P25 --> P3 : Снятие подсветки
P25 --> P5 : Триггер отмены

' P2.6
BDPN --> P26 : NP Suspend Request,\nNP Suspend Exec
P26 --> P3 : Блокировка через RICH
BDPN --> P26 : NP Suspend Cancel, NP Resume
P26 --> P3 : Разблокировка
P26 --> P5 : Напоминание о задолженности

' P2.7
D8 --> P27 : Событие CCB\n(номер в отстойнике)
P27 --> BDPN : NP Return
BDPN --> P27 : NP CDB Confirm,\nNP Return Exec
P27 --> P3 : Прописание RN

' P2.8
BDPN --> P28 : SFTP-файлы (Port_All,\nPort_All_Full, Port_Increment,\nReturn_Increment, Numbering_plan,\nStatus_Code, Operators)
P28 --> D6 : Сохранение в S3
P28 --> D5 : Обновление справочников\n(NPCDB_NUMBERING_PLAN)
P28 --> D8 : Событие загрузки файлов

@enduml